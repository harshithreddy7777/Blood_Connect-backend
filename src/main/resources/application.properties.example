# Example Environment Configuration for BloodConnect Backend
spring.application.name=BloodConnect-Backend
server.port=8080

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/blood_connect_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Settings
jwt.secret=your_super_secret_base64_or_hex_key_minimum_256_bits
jwt.expiration=86400000
